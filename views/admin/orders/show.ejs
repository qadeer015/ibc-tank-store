<div class="pagetitle">
  <h1><%= order.order_number %></h1>
</div>
<section class="section">
  <div class="card">
    <div class="card-body pt-3">
      <p><strong><%= order.full_name %></strong> · <%= order.phone %><% if (order.email) { %> · <%= order.email %><% } %></p>
      <p><%= order.address_line1 %><% if (order.address_line2) { %>, <%= order.address_line2 %><% } %>, <%= order.city %></p>
      <% if (order.notes) { %><p>Notes: <%= order.notes %></p><% } %>
      <p>Payment: <%= order.payment_method %> / <%= order.payment_status %></p>
      <ul>
        <% order.items.forEach(function(item) { %>
          <li><%= item.quantity %> × <%= item.product_name %> @ <%= Number(item.price_at_purchase).toLocaleString('en-PK') %></li>
        <% }) %>
      </ul>
      <p>Delivery <%= Number(order.delivery_charges).toLocaleString('en-PK') %> · Total <strong><%= Number(order.total_amount).toLocaleString('en-PK') %></strong></p>
      <form action="/admin/orders/<%= order.id %>/status" method="POST" class="d-flex gap-2 align-items-center">
        <label for="order_status" class="mb-0">Status</label>
        <select id="order_status" name="order_status" class="form-select" style="max-width:220px">
          <% ['pending','packed','shipped','delivered','cancelled'].forEach(function(status) { %>
            <option value="<%= status %>" <%= order.order_status === status ? 'selected' : '' %>><%= status %></option>
          <% }) %>
        </select>
        <button class="btn btn-success" type="submit">Save</button>
      </form>
      <p class="text-muted mt-3 mb-0">Cancelling returns the items to stock. Reopening a cancelled order takes the stock again.</p>
    </div>
  </div>
</section>
