<!-- views/admin/products/show.ejs -->
<div class="row">
    <div class="col-lg-5">
        <% if (productImages && productImages.length > 0) { %>
        <div class="ibc-product-gallery">
          <div class="ibc-product-gallery-main">
            <img id="mainProductImage" src="<%= productImages[0] %>" alt="<%= product.name %>" class="ibc-product-gallery-img" data-index="0" />
            <button class="ibc-gallery-nav ibc-gallery-prev" type="button"><i class="bi bi-chevron-left"></i></button>
            <button class="ibc-gallery-nav ibc-gallery-next" type="button"><i class="bi bi-chevron-right"></i></button>
            <% if (productImages.length > 1) { %>
            <div class="ibc-badge-count"><%= productImages.length %> Photos</div>
            <% } %>
          </div>
          <!-- Thumbnails -->
          <div class="ibc-product-thumbnails">
            <% productImages.forEach((image, index) => { %>
            <div class="ibc-thumb-item <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
              <img src="<%= image %>" alt="Thumbnail <%= index + 1 %>" />
            </div>
            <% }) %>
          </div>
        </div>
        <% } else { %>
        <div class="ibc-product-gallery-main" style="display:flex;align-items:center;justify-content:center;background:var(--ibc-gray-100);min-height:300px;">
          <div style="text-align:center;color:var(--ibc-gray-500);">
            <i class="bi bi-image" style="font-size:48px;margin-bottom:12px;display:block"></i>
            <p>No image available</p>
          </div>
        </div>
        <% } %>
    </div>

    <!-- Product Info -->
    <div class="col-lg-7">
        <div class="card bg-transparent border-0">
            <div class="card-body">
                <!-- Price -->
                <div class="mt-3 mb-2">
                    <strong class="fw-semibold">
                        Price :
                    </strong>
                    <span class="lead">
                        <%= product.price %>
                    </span>
                </div>

                <!-- Stock -->
                <div class="my-2">
                    <strong class="fw-semibold">
                        Stock quantity :
                    </strong>
                    <span class="lead">
                        <%= product.stock %>
                    </span>
                </div>

                <!-- Stock -->
                <div class="my-2">
                    <strong class="fw-semibold">
                        Condition :
                    </strong>
                    <span class="lead">
                        <%= product.product_condition %>
                    </span>
                </div>

                <!-- Rating Display -->
                <div class="d-flex align-items-center gap-2">
                    <strong class="fw-semibold">
                        Ratting :
                    </strong>
                    <div class="me-2">
                        <% for(let i=1; i<=5; i++) { %>
                            <% if(i <=Math.floor(product.rating)) { %>
                                <i class="bi bi-star-fill text-warning"></i>
                                <% } else if(i===Math.ceil(product.rating) && product.rating % 1> 0) { %>
                                    <i class="bi bi-star-half text-warning"></i>
                                    <% } else { %>
                                        <i class="bi bi-star text-warning"></i>
                                        <% } %>
                                            <% } %>
                    </div>
                    <span class="text-muted">
                        (<%= product.rating_count %>)
                    </span>
                </div>

                <div class="d-flex align-items-center gap-2 mt-3">
                    <a href="/admin/products/<%= product.id %>/edit" class="btn btn-sm btn-primary">
                        <i class="bi bi-pencil"></i>
                        Edit
                    </a>
                    <form action="/admin/products/<%= product.id %>/delete"
                        onclick="return confirm('Are you sure to delete ?')" method="POST">
                        <button class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i>
                            Delete
                        </button>
                    </form>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="copyReviewLinkButton"
                        data-product-id="<%= product.id %>">
                        <i class="bi bi-clipboard"></i>
                        Copy review link
                    </button>
                </div>
                <p id="copyReviewLinkStatus" class="small mt-2 mb-0" role="status" aria-live="polite"></p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div id="tabs">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#description">Description</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#additional-info">Additional Info</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#specs">Specifications</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#reviews">Reviews</a>
            </li>
        </ul>
    </div>
</div>

<div class="row tab-pane py-3" id="description">
    <div class="col-lg-12">
        <div class="card bg-transparent border-0">
            <div class="card-body">
                <h4 class="text-primary fw-semibold mb-3">
                    Description
                </h4>
                <p class="text-muted">
                    <%- product.description || 'No description available.' %>
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row tab-pane py-3" id="additional-info" style="display: none;">
    <div class="col-lg-12">
        <div class="card bg-transparent border-0">
            <div class="card-body">
                <h4 class="text-primary fw-semibold mb-3">
                    Additional Information
                </h4>
                <% if (product.additional_info && Object.keys(product.additional_info).length> 0) { %>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <tbody>
                                <% Object.entries(product.additional_info).forEach(([key, value])=> { %>
                                    <tr>
                                        <td class="fw-semibold" style="width: 30%;">
                                            <%= key %>
                                        </td>
                                        <td>
                                            <%= value %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                        <p class="text-muted">No additional information available.</p>
                        <% } %>
            </div>
        </div>
    </div>
</div>

<div class="row tab-pane py-3" id="specs" style="display: none;">
    <div class="col-lg-12">
        <div class="card bg-transparent border-0">
            <div class="card-body">
                <h4 class="text-primary fw-semibold mb-3">
                    Product Specifications
                </h4>
                <% if (product.specs && Object.keys(product.specs).length> 0) { %>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <tbody>
                                <% Object.entries(product.specs).forEach(([key, value])=> { %>
                                    <tr>
                                        <td class="fw-semibold" style="width: 30%;">
                                            <%= key %>
                                        </td>
                                        <td>
                                            <%= value %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                        <p class="text-muted">No specifications available.</p>
                        <% } %>
            </div>
        </div>
    </div>
</div>

<div class="row tab-pane py-3" id="reviews" style="display: none;">
    <div class="col-lg-12">
        <div class="card bg-transparent border-0">
            <div class="card-body">
                <h4 class="text-primary fw-semibold mb-3">
                    Reviews
                </h4>
                <% if (reviews.length === 0) { %>
                    <p class="text-muted">No reviews yet.</p>
                <% } %>
                <% for (let review of reviews) { %>
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between w-100">
                                <div class="d-flex flex-column">
                                    <h6 class="mb-0"><%= review.nickname || 'Customer' %></h6>
                                    <% if (review.email) { %>
                                        <small class="text-muted"><%= review.email %></small>
                                    <% } %>
                                    <div class="mt-1">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <% if (i <= Math.floor(review.rating)) { %>
                                                <i class="bi bi-star-fill text-warning"></i>
                                            <% } else if (i === Math.ceil(review.rating) && review.rating % 1 > 0) { %>
                                                <i class="bi bi-star-half text-warning"></i>
                                            <% } else { %>
                                                <i class="bi bi-star text-warning"></i>
                                            <% } %>
                                        <% } %>
                                    </div>
                                    <% if (review.review_title) { %>
                                        <strong class="mt-2"><%= review.review_title %></strong>
                                    <% } %>
                                    <% if (review.review) { %>
                                        <p class="text-muted mb-0"><%= review.review %></p>
                                    <% } %>
                                </div>
                                <div class="text-muted">
                                    <%= new Date(review.created_at).toLocaleDateString() %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<script>
    /* Tabs */
    const tabs = document.querySelectorAll('.nav-tabs a');

    tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
            e.preventDefault();

            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

            const targetTab = tab.getAttribute('href');
            document.querySelectorAll('.tab-pane')
                .forEach(p => p.style.display = 'none');

            document.querySelector(targetTab).style.display = 'block';
        });
    });

    /* Product image gallery + Fancybox (admin) */
    (function () {
        const mainImg = document.getElementById('mainProductImage');
        if (!mainImg) return;

        const thumbs = Array.from(document.querySelectorAll('.ibc-thumb-item, .product-thumb'));
        if (!thumbs.length) return;

        // Full-size image list rendered by the server, so it does not depend on
        // thumbnail markup (the .ibc-thumb-item wrapper is a div without src).
        const images = <%- JSON.stringify((typeof productImages !== 'undefined' ? productImages : []) || []).replace(/</g, '\\u003c') %>;
        if (!images.length) return;

        let currentIndex = parseInt(mainImg.getAttribute('data-index'), 10) || 0;

        const setMainImage = (index) => {
            currentIndex = ((index % images.length) + images.length) % images.length;
            mainImg.src = images[currentIndex];
            mainImg.setAttribute('data-index', String(currentIndex));
            thumbs.forEach((t, i) => t.classList.toggle('active', i === currentIndex));
        };

        const openFancybox = (startIndex) => {
            if (typeof Fancybox === 'undefined' || !images.length) return;
            Fancybox.show(
                images.map(src => ({ src, type: 'image' })),
                {
                    startIndex: typeof startIndex === 'number' ? startIndex : currentIndex,
                    Thumbs: { autoStart: true }
                }
            );
        };

        // Thumbnail click: show image big + keep main image in sync
        thumbs.forEach(thumb => {
            thumb.addEventListener('click', () => {
                const parsed = parseInt(thumb.getAttribute('data-index'), 10);
                const index = isNaN(parsed) ? thumbs.indexOf(thumb) : parsed;
                setMainImage(index);
                openFancybox(index);
            });
        });

        // Prev / Next navigation
        const prevBtn = document.querySelector('.ibc-gallery-prev, .gallery-nav.prev');
        const nextBtn = document.querySelector('.ibc-gallery-next, .gallery-nav.next');

        if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                setMainImage(currentIndex - 1);
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                setMainImage(currentIndex + 1);
            });
        }

        // Single image: hide navigation arrows
        if (images.length < 2) {
            if (prevBtn) prevBtn.style.display = 'none';
            if (nextBtn) nextBtn.style.display = 'none';
        }

        // Main image click: open Fancybox lightbox with all images
        mainImg.style.cursor = 'zoom-in';
        mainImg.addEventListener('click', () => openFancybox());
    })();
</script>
<script>
    const copyReviewLinkButton = document.getElementById('copyReviewLinkButton');
    const copyReviewLinkStatus = document.getElementById('copyReviewLinkStatus');

    copyReviewLinkButton.addEventListener('click', async () => {
        const reviewLink = new URL(
            `/products/${encodeURIComponent(copyReviewLinkButton.dataset.productId)}?action=write_a_review`,
            window.location.origin
        ).toString();

        try {
            await navigator.clipboard.writeText(reviewLink);
            copyReviewLinkStatus.textContent = 'Review link copied to clipboard.';
            copyReviewLinkStatus.classList.remove('text-danger');
            copyReviewLinkStatus.classList.add('text-success');
        } catch (error) {
            copyReviewLinkStatus.textContent = 'Unable to copy the review link. Check clipboard permissions and try again.';
            copyReviewLinkStatus.classList.remove('text-success');
            copyReviewLinkStatus.classList.add('text-danger');
            console.error('Copying review link failed:', error);
        }
    });
</script>