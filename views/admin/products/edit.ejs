<!-- views/admin/products/edit.ejs -->

<%# Server injects existing image URLs; controller reads this on connect() %>
    <script id="product-images-data" type="application/json">
    <%- JSON.stringify(productImages || []) %>
</script>

    <section class="mt-5" data-controller="product">
        <form action="/admin/products/<%= product.id %>/update" method="POST" class="row g-3" data-target="product.form"
            data-action="submit->product#onSubmit">
            <div class="row">
                <!-- ─── Left column: text fields ─────────────────────── -->
                <div class="col-lg-8">
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label for="name" class="form-label fw-semibold">Product Name</label>
                            <input type="text" name="name" class="form-control" value="<%= product.name %>" required>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label for="price" class="form-label fw-semibold">Price</label>
                            <input type="number" name="price" class="form-control" value="<%= product.price %>"
                                min="0" step="0.01" required>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label for="sale_price" class="form-label fw-semibold">Sale price</label>
                            <input type="number" name="sale_price" class="form-control" min="0" step="0.01"
                                placeholder="Optional, lower than price"
                                value="<%= product.sale_price != null ? product.sale_price : '' %>">
                            <small class="text-muted">Leave blank when the product is not on sale.</small>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label for="margin_percent" class="form-label fw-semibold">Margin %</label>
                            <input type="number" name="margin_percent" class="form-control" min="0" max="100" step="0.01"
                                placeholder="0–100"
                                value="<%= product.margin_percent != null ? product.margin_percent : '' %>">
                            <small class="text-muted">Admin only. Profit margin on the selling price.</small>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label for="stock" class="form-label fw-semibold">Stock</label>
                            <input type="number" name="stock" class="form-control" value="<%= product.stock %>"
                                required>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label for="product_condition" class="form-label fw-semibold">Select product
                                condition</label>
                            <select name="product_condition" id="product_condition" class="form-select" required>
                                <option value=""></option>
                                <option value="New" <%=product.product_condition==='New' ? 'selected' : '' %>>New
                                </option>
                                <option value="Used" <%=product.product_condition==='Used' ? 'selected' : '' %>>Used
                                </option>
                                <option value="Refurbished" <%=product.product_condition==='Refurbished' ? 'selected'
                                    : '' %>>Refurbished</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label for="category_id" class="form-label fw-semibold">Select Category</label>
                            <select name="category_id" id="category_id" class="form-select" required>
                                <option value=""></option>
                                <% categories.forEach(category=> { %>
                                    <option value="<%= category.id %>" <%=product.category_id===category.id ? 'selected'
                                        : '' %>>
                                        <%= category.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="description" class="form-label fw-semibold">Description</label>
                            <textarea class="form-control tinymce-editor" id="description" name="description"
                                rows="10"><%= product && product.description ? product.description : '' %></textarea>
                        </div>

                        <!-- Additional Information -->
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold">Additional Information</label>
                            <p class="text-muted small mb-2">Shown on the product page under Additional Info. Blank rows are ignored.</p>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <% ['Warranty','Lead time','Minimum order','Delivery'].forEach(function(label) { %>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="click->product#addPresetInfo" data-info-key="<%= label %>">
                                        <%= label %>
                                    </button>
                                <% }) %>
                            </div>
                            <div id="additional_info_container" class="mb-2">
                                <% const infoEntries = product && product.additional_info ? Object.entries(product.additional_info) : []; %>
                                <% const infoRows = infoEntries.length ? infoEntries : [['', '']]; %>
                                <% infoRows.forEach(([key, value]) => { %>
                                    <div class="row additional-info-row mb-2 g-2 align-items-center">
                                        <div class="col-md-5">
                                            <input type="text" class="form-control" placeholder="Label"
                                                name="additional_info_key[]" value="<%= key %>">
                                        </div>
                                        <div class="col-md-5">
                                            <input type="text" class="form-control" placeholder="Value"
                                                name="additional_info_value[]" value="<%= value %>">
                                        </div>
                                        <div class="col-md-2 d-flex gap-1">
                                            <button type="button" class="btn btn-outline-secondary btn-sm move-up" title="Move up" aria-label="Move up">
                                                <i class="bi bi-arrow-up"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm move-down" title="Move down" aria-label="Move down">
                                                <i class="bi bi-arrow-down"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm delete-row" title="Remove" aria-label="Remove row">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <button type="button" class="btn btn-outline-success btn-sm"
                                data-action="click->product#addInfoRow">
                                <i class="bi bi-plus"></i> Add Row
                            </button>
                        </div>

                        <!-- Product Specifications -->
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold">Product Specifications</label>
                            <p class="text-muted small mb-2">Capacity, material, and other specs shown on the product page. Use a label only once.</p>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <% ['Capacity','Material','Dimensions','Weight','Valve','Pallet','UN rating'].forEach(function(label) { %>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                        data-action="click->product#addPresetSpec" data-spec-key="<%= label %>">
                                        <%= label %>
                                    </button>
                                <% }) %>
                            </div>
                            <div id="specs_container" class="mb-2">
                                <% const specEntries = product && product.specs ? Object.entries(product.specs) : []; %>
                                <% const specRows = specEntries.length ? specEntries : [['', '']]; %>
                                <% specRows.forEach(([key, value]) => { %>
                                    <div class="row specs-row mb-2 g-2 align-items-center">
                                        <div class="col-md-5">
                                            <input type="text" class="form-control" placeholder="Label"
                                                name="specs_key[]" value="<%= key %>">
                                        </div>
                                        <div class="col-md-5">
                                            <input type="text" class="form-control" placeholder="Value"
                                                name="specs_value[]" value="<%= typeof value === 'object' ? JSON.stringify(value) : value %>">
                                        </div>
                                        <div class="col-md-2 d-flex gap-1">
                                            <button type="button" class="btn btn-outline-secondary btn-sm move-up" title="Move up" aria-label="Move up">
                                                <i class="bi bi-arrow-up"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm move-down" title="Move down" aria-label="Move down">
                                                <i class="bi bi-arrow-down"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm delete-row" title="Remove" aria-label="Remove row">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <button type="button" class="btn btn-outline-success btn-sm"
                                data-action="click->product#addSpecsRow">
                                <i class="bi bi-plus"></i> Add Row
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ─── Right column: image upload ───────────────────── -->
                <div class="col-lg-4">
                    <label class="form-label fw-semibold">Product Image</label>
                    <div class="image-upload-container border rounded py-4 px-3 text-center">

                        <%# Preview container starts visible on edit (existing images will be populated by controller)
                            %>
                            <div class="mb-3" data-target="product.imagePreviewContainer">
                                <div class="d-flex gap-2 flex-wrap justify-content-center"
                                    data-target="product.thumbnails"></div>
                            </div>

                            <div class="p-4 border-dashed rounded" data-target="product.uploadArea">
                                <input type="file" name="image" class="d-none" accept="image/*" multiple
                                    data-target="product.imageInput" data-action="change->product#onFileChange"
                                    id="imageInput">
                                <div class="upload-placeholder"
                                    onclick="document.getElementById('imageInput').click();">
                                    <i class="bi bi-cloud-upload display-4 text-muted"></i>
                                    <p class="mt-2 text-muted">Click to upload or drag and drop</p>
                                    <small class="text-muted">SVG, PNG, JPG or GIF (max. 5MB)</small>
                                </div>
                            </div>

                            <div class="mt-3 d-none" data-target="product.uploadLoading">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading…</span>
                                </div>
                                <p class="mt-2 text-muted">Processing image…</p>
                            </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success" data-target="product.submitBtn">
                    Update Product
                </button>
                <a href="/admin/products" class="btn btn-outline-secondary mx-2">Cancel</a>
            </div>
        </form>
    </section>