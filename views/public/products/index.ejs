<!-- Products Page -->
<section class="ibc-page-hero">
  <div class="ibc-container">
    <div class="ibc-breadcrumb">
      <a href="/">Home</a> <i class="bi bi-chevron-right" style="font-size:10px"></i>
      <span>Products</span>
    </div>
    <h1>All Products</h1>
    <p>Browse our complete range of IBC tanks for every application.</p>
  </div>
</section>

<section class="ibc-section ibc-bg-white">
  <div class="ibc-container">
    <style>
      .ibc-catalog-layout { display: grid; grid-template-columns: minmax(220px, 280px) minmax(0, 1fr); gap: 28px; align-items: start; }
      .ibc-filter-fields { display: grid; gap: 12px; }
      .ibc-filter-fields label { font-size: 13px; font-weight: 600; color: var(--ibc-gray-700); margin-bottom: 4px; display: block; }
      .ibc-filter-fields input, .ibc-filter-fields select { width: 100%; padding: 10px 14px; border: 2px solid var(--ibc-gray-300); border-radius: var(--ibc-radius-sm); font-size: 14px; background: var(--ibc-white); }
      .ibc-filter-check { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
      .ibc-filter-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
      .ibc-filter-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 999px; background: var(--ibc-gray-100); color: var(--ibc-dark); text-decoration: none; font-size: 13px; font-weight: 600; }
      @media (max-width: 860px) { .ibc-catalog-layout { grid-template-columns: 1fr; } }
    </style>
    <div class="ibc-catalog-layout">
      <!-- Filters -->
      <div class="ibc-filter-card">
        <form action="/products" method="GET" class="ibc-filter-fields">
          <div>
            <label for="filter-category">Category</label>
            <select id="filter-category" name="category">
              <option value="">All Categories</option>
              <% categories.forEach(category => { %>
                <option value="<%= category.id %>" <%= selectedCategory == category.id ? 'selected' : '' %>>
                  <%= category.name %>
                </option>
              <% }); %>
            </select>
          </div>
          <div>
            <label for="filter-min">Min price (<%= settings.price_currency || 'PKR' %>)</label>
            <input id="filter-min" type="number" name="minPrice" min="0" placeholder="Min" value="<%= minPrice != null ? minPrice : '' %>">
          </div>
          <div>
            <label for="filter-max">Max price (<%= settings.price_currency || 'PKR' %>)</label>
            <input id="filter-max" type="number" name="maxPrice" min="0" placeholder="Max" value="<%= maxPrice != null ? maxPrice : '' %>">
          </div>
          <div>
            <label for="filter-condition">Condition</label>
            <select id="filter-condition" name="condition">
              <option value="">Any</option>
              <option value="new" <%= condition === 'new' ? 'selected' : '' %>>New</option>
              <option value="used" <%= condition === 'used' ? 'selected' : '' %>>Used</option>
              <option value="refurbished" <%= condition === 'refurbished' ? 'selected' : '' %>>Refurbished</option>
            </select>
          </div>
          <div>
            <label for="filter-sort">Sort</label>
            <select id="filter-sort" name="sort">
              <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
              <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
              <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
              <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name</option>
            </select>
          </div>
          <label class="ibc-filter-check">
            <input type="checkbox" name="inStock" value="1" <%= inStock ? 'checked' : '' %>>
            In stock only
          </label>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button type="submit" class="ibc-btn ibc-btn-primary">Apply Filters</button>
            <a href="/products" class="ibc-btn ibc-btn-dark">Clear</a>
          </div>
        </form>
      </div>

      <!-- Product Results -->
      <div>
        <% if (chips && chips.length) { %>
          <div class="ibc-filter-chips" aria-label="Active filters">
            <% chips.forEach(function(chip) { %>
              <a class="ibc-filter-chip" href="<%= chip.href %>"><%= chip.label %> <i class="bi bi-x"></i></a>
            <% }) %>
            <a class="ibc-filter-chip" href="/products">Clear all</a>
          </div>
        <% } %>
        <% if (products.length === 0) { %>
          <div style="text-align:center;padding:48px 24px;background:var(--ibc-gray-100);border-radius:var(--ibc-radius-lg)">
            <i class="bi bi-box" style="font-size:48px;color:var(--ibc-gray-500);margin-bottom:16px;display:block"></i>
            <h3 style="font-size:20px;color:var(--ibc-dark);margin-bottom:8px">No Products Found</h3>
            <p style="color:var(--ibc-gray-500)">Try adjusting your filters or browse our product categories.</p>
            <a href="/products" class="ibc-btn ibc-btn-primary" style="margin-top:16px">View All Products</a>
          </div>
        <% } else { %>
          <p style="font-size:14px;color:var(--ibc-gray-500);margin-bottom:16px"><%= products.length %> product<%= products.length > 1 ? 's' : '' %> found</p>
          <div class="ibc-products-grid">
            <% products.forEach(function(product) { %>
            <a href="/products/<%= product.id %>" class="ibc-product-card ibc-animate" style="text-decoration:none;color:inherit;display:block">
              <div class="ibc-product-img-wrapper">
                <img src="<%= product.image %>" alt="<%= product.name %>" class="ibc-product-img" loading="lazy" width="400" height="220">
              </div>
              <div class="ibc-product-body">
                <div class="d-flex align-items-center justify-content-between">
                  <h3><%= product.name %></h3>
                  <div class="ibc-product-capacity" title="Capacity: <%= product.specs && product.specs.capacity ? product.specs.capacity : '' %>"><i class="bi bi-box"></i><%= product.specs && product.specs.capacity ? product.specs.capacity : '' %></div>
                </div>
                <% const pricing = product.pricing || { onSale: false, current: product.price, list: product.price, discountPercent: 0 }; %>
                <p style="margin:8px 0 0;font-weight:700;color:var(--ibc-dark)">
                  <% if (pricing.onSale) { %>
                    <span><%= settings.price_currency %><%= Number(pricing.current).toLocaleString('en-PK') %></span>
                    <span style="text-decoration:line-through;color:var(--ibc-gray-500);font-weight:500;margin-left:6px"><%= settings.price_currency %><%= Number(pricing.list).toLocaleString('en-PK') %></span>
                    <span class="ibc-info-badge" style="margin-left:6px"><%= pricing.discountPercent %>% off</span>
                  <% } else { %>
                    <%= settings.price_currency %><%= Number(product.price || 0).toLocaleString('en-PK') %>
                  <% } %>
                </p>
                <!-- <p class="ibc-product-usage"><%- product.description %></p> -->
              </div>
              <div class="ibc-product-hover-arrow"><i class="bi bi-arrow-right"></i></div>
            </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>