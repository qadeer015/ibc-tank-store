<script>
  (function () {
    const search = document.getElementById('usesSearch');
    const ideas = Array.from(document.querySelectorAll('.ibc-use-idea'));
    const filters = Array.from(document.querySelectorAll('[data-use-filter]'));
    const empty = document.getElementById('ibcUseEmpty');
    const resultCount = document.getElementById('usesResultCount');
    let activeFilter = 'all';

    function updateIdeas() {
      const term = search.value.trim().toLowerCase();
      let visibleCount = 0;

      ideas.forEach(function (idea) {
        const categoryMatches = activeFilter === 'all' || idea.dataset.category === activeFilter;
        const searchMatches = !term || idea.textContent.toLowerCase().includes(term);
        const isVisible = categoryMatches && searchMatches;
        idea.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      empty.hidden = visibleCount > 0;
      resultCount.textContent = visibleCount + (visibleCount === 1 ? ' idea' : ' ideas');
    }

    search.addEventListener('input', updateIdeas);
    filters.forEach(function (button) {
      button.addEventListener('click', function () {
        activeFilter = button.dataset.useFilter;
        filters.forEach(function (filter) {
          const isActive = filter === button;
          filter.classList.toggle('btn-primary', isActive);
          filter.classList.toggle('active', isActive);
          filter.classList.toggle('btn-outline-primary', !isActive);
          filter.setAttribute('aria-pressed', String(isActive));
        });
        updateIdeas();
      });
    });
  })();
</script>