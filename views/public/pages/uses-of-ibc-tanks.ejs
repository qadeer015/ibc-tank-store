      <button type="button" class="btn btn-outline-primary" data-use-filter="garden" aria-pressed="false">Garden &amp; water</button>
      <button type="button" class="btn btn-outline-primary" data-use-filter="animals" aria-pressed="false">Animal care</button>
      <button type="button" class="btn btn-outline-primary" data-use-filter="home" aria-pressed="false">Home &amp; outdoor</button>
      <button type="button" class="btn btn-outline-primary" data-use-filter="farm" aria-pressed="false">Farm &amp; utility</button>
      <button type="button" class="btn btn-outline-primary" data-use-filter="workshop" aria-pressed="false">Workshop</button>
    </div>

    <div class="row g-4" id="ibcUseIdeas" aria-label="IBC tank uses">
      <% ideas.forEach(function (idea, index) { %>
      <div class="col-md-6 col-lg-4 ibc-use-idea" data-category="<%= idea.category %>">
        <article class="card h-100 shadow-sm ibc-animate">
          <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-3">
              <i class="bi <%= idea.icon %> fs-4 text-primary" aria-hidden="true"></i>
              <span class="badge bg-light text-dark"><%= idea.categoryLabel %></span>
            </div>
            <span class="small text-primary fw-bold text-uppercase mb-2"><%= String(index + 1).padStart(2, '0') %> / <%= idea.topic %></span>
            <h3 class="h5 card-title"><%= idea.title %></h3>
            <p class="card-text text-muted"><%= idea.description %></p>
            <div class="border-top pt-3 mt-auto small">
              <strong>Example:</strong> <%= idea.example %>
            </div>
          </div>
        </article>
      </div>
      <% }); %>
    </div>

    <p id="ibcUseEmpty" class="alert alert-info mt-4" role="status" hidden>No matching ideas found. Try another search term or category.</p>

    <aside class="alert alert-warning mt-5 mb-0" role="note">
