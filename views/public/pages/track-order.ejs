<section class="ibc-page-hero">
  <div class="ibc-container">
    <h1>Track your order</h1>
    <p>Use the order number from your confirmation and the phone number on the order.</p>
  </div>
</section>

<section class="ibc-section ibc-bg-white">
  <div class="ibc-container" style="max-width:760px">
    <form action="/order-tracking" method="GET" style="display:grid;gap:12px;margin-bottom:24px">
      <label>Order number<input name="order" required value="<%= orderNumber || '' %>" placeholder="IBC-2026-00001" style="width:100%;padding:10px;border:1px solid var(--ibc-gray-300);border-radius:8px"></label>
      <label>Phone<input name="phone" required value="<%= phone || '' %>" style="width:100%;padding:10px;border:1px solid var(--ibc-gray-300);border-radius:8px"></label>
      <button type="submit" class="ibc-btn ibc-btn-primary">Track order</button>
    </form>

    <% if (searched && !order) { %>
      <p>No order matched that number and phone.</p>
    <% } else if (order) { %>
      <h2><%= order.order_number %></h2>
      <p>Status: <strong><%= order.order_status %></strong></p>
      <p>Payment: <%= order.payment_method === 'bank_transfer' ? 'Bank transfer' : 'Cash on delivery' %> (<%= order.payment_status %>)</p>
      <ul>
        <% order.items.forEach(function(item) { %>
          <li><%= item.quantity %> × <%= item.product_name %></li>
        <% }) %>
      </ul>
      <p>Total <%= currency %> <%= Number(order.total_amount).toLocaleString('en-PK') %></p>
      <p>Delivering to <%= order.city %></p>
    <% } %>
  </div>
</section>
